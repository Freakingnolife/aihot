# AdditiveOS Radar on the NAS. Copy to .env (same folder) and fill in the empty values.
# .env is git-ignored: never commit it and never paste it into chat. Use letters and digits only in
# secrets (openssl rand -hex 32): a "$" would be read as a variable by Docker Compose.

# ===== Public address =====
# Canonical links, share cards, sitemap, feeds and the MCP host check use this.
SITE_URL=https://additiveos.com
# The reader sits behind Cloudflare and the router: read the visitor address from X-Forwarded-For.
TRUST_PROXY=true

# ===== Secrets (empty on purpose: the services refuse to start until they are set) =====
POSTGRES_PASSWORD=
# At least 12 characters. Signs in to /admin.
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# ===== Safety switches =====
# The scheduler collects when COLLECT_ENABLED is true and processes when MODEL_CALLS_ENABLED is true.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false

# ===== Model route: the Codex connector (no API key) =====
LLM_BASE_URL=http://codex-shim:4340/v1
LLM_API_KEY=local-codex
LLM_MODEL=gpt-6.1-sol
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
CODEX_MODEL=gpt-6.1-sol
CODEX_EFFORT=medium
# Host folder that holds the owner's Codex sign-in (auth.json), mounted read-write at /home/node/.codex.
# Create it, copy ~/.codex/auth.json into it and make it writable for uid 1000 (see README).
CODEX_AUTH_DIR=/volume1/additiveos/radar/codex-auth

# ===== Router (the only thing the Cloudflare Tunnel talks to) =====
ROUTER_PORT=38090
# The reader's loopback port, used by the router (host network).
WEB_LOOPBACK_PORT=38091
# The existing landing container publishes 127.0.0.1:38088 on the host; the router runs in the host network.
LANDING_UPSTREAM=http://127.0.0.1:38088
